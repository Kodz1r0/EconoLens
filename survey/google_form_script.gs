function createForm() {
  const form = FormApp.create(S.title);
  form.setDescription(S.intro)
      .setCollectEmail(false)
      .setProgressBar(true)
      .setShowLinkToRespondAgain(true)
      .setConfirmationMessage(S.thanks);

  form.addCheckboxItem().setTitle(S.agree).setChoiceValues([S.agree]).setRequired(true);
  form.addCheckboxItem().setTitle(S.pilot).setChoiceValues([S.pilot]);

  form.addPageBreakItem().setTitle(S.about);
  form.addMultipleChoiceItem().setTitle(S.age).setChoiceValues(S.ages).setRequired(true);
  form.addMultipleChoiceItem().setTitle(S.role).setChoiceValues(S.roles).setRequired(true);
  form.addMultipleChoiceItem().setTitle(S.econ).setChoiceValues(S.yn).setRequired(true);
  form.addMultipleChoiceItem().setTitle(S.budget).setChoiceValues(S.budgets);

  form.addPageBreakItem().setTitle(S.pre).setHelpText(S.pre_p);
  addQuiz(form, 'pre');

  form.addPageBreakItem().setTitle(S.split).setHelpText(S.split_p);
  const split = form.addMultipleChoiceItem().setTitle(S.split_q).setRequired(true);

  const pageA = form.addPageBreakItem().setTitle(S.taskA)
    .setHelpText(S.stepsCommon_ru + '\n' + S.stepA_ru + '\n' + S.back_ru + '\n\n' + S.stepsCommon_uz + '\n' + S.stepA_uz + '\n' + S.back_uz);
  addResultItems(form, false);

  const pageB = form.addPageBreakItem().setTitle(S.taskB)
    .setHelpText(S.stepsCommon_ru + '\n' + S.stepB_ru + '\n' + S.back_ru + '\n\n' + S.stepsCommon_uz + '\n' + S.stepB_uz + '\n' + S.back_uz);
  addResultItems(form, true);

  const pagePost = form.addPageBreakItem().setTitle(S.post).setHelpText(S.post_p);
  addQuiz(form, 'post');

  form.addPageBreakItem().setTitle(S.fb);
  form.addScaleItem().setTitle(S.use).setBounds(1, 5).setLabels(S.use_lo, S.use_hi).setRequired(true);
  form.addMultipleChoiceItem().setTitle(S.sur).setChoiceValues(S.surs).setRequired(true);
  form.addParagraphTextItem().setTitle(S.cmt);

  split.setChoices([split.createChoice(S.even, pageA), split.createChoice(S.odd, pageB)]);
  pageB.setGoToPage(pagePost);

  const ss = SpreadsheetApp.create('EconoLens survey — responses');
  form.setDestination(FormApp.DestinationType.SPREADSHEET, ss.getId());

  Logger.log('Form for participants: ' + form.getPublishedUrl());
  Logger.log('Edit the form: ' + form.getEditUrl());
  Logger.log('Responses sheet: ' + ss.getUrl());
}

function addQuiz(form, tag) {
  QUIZ.forEach(function (q, i) {
    form.addMultipleChoiceItem()
      .setTitle('[' + tag + '-' + q.id + '] ' + q.t)
      .setChoiceValues(q.o)
      .setRequired(true);
  });
  form.addScaleItem().setTitle('[' + tag + '-self] ' + S.self_q).setBounds(1, 5).setLabels(S.self_lo, S.self_hi).setRequired(true);
}

function addResultItems(form, isB) {
  const g = isB ? 'B' : 'A';
  form.addTextItem().setTitle('[' + g + '] ' + S.your).setRequired(true);
  form.addTextItem().setTitle('[' + g + '] ' + S.off);
  if (isB) form.addMultipleChoiceItem().setTitle('[B] ' + S.aiok).setChoiceValues(S.yn.slice(0, 2)).setRequired(true);
}
